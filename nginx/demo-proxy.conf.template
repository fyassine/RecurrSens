# ==========================================================================
# HTTPS — Demo (demo.recurrsens.eu)
# ==========================================================================
# This file is conditionally included by the entrypoint script only if
# the demo SSL certificate exists at /etc/letsencrypt/live/demo.recurrsens.eu/
# ==========================================================================
server {
    listen 443 ssl;
    server_name demo.recurrsens.eu;

    ssl_certificate /etc/letsencrypt/live/demo.recurrsens.eu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/demo.recurrsens.eu/privkey.pem;

    # SSL hardening
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    client_max_body_size 50M;

    # Resolve demo container at request time (not at startup)
    # so nginx can start even when the demo stack is down.
    # 127.0.0.11 is Docker's embedded DNS server.
    resolver 127.0.0.11 valid=30s;
    set $demo_upstream http://recurrsens-demo-nginx-1:80;

    # Proxy everything to the demo nginx container
    location / {
        proxy_pass $demo_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;

        # WebSocket support (if needed)
        proxy_set_header Connection "upgrade";
        proxy_set_header Upgrade $http_upgrade;
        proxy_http_version 1.1;
    }
}
