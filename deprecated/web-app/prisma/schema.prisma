generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Diagnosis {
  LEFT
  RIGHT
  BOTH
  HEALTHY
  TODO
}

enum Prediction {
  TODO
  INFECTED
  HEALTHY
}

model Patient {
  id          String      @id @default(uuid()) // This is the token
  patientId   String      // Human readable ID
  status      String      @default("NEW")
  gender      String?     // M, W, D, ?
  birthDate   DateTime?
  preOpDate   DateTime?
  postOpDate  DateTime?
  diagnosis   Diagnosis?  @default(TODO)
  diagnosisText String?   // Optional text for diagnosis details
  
  // Pre-Op AI Results
  predictionPre      String     @default("TODO")
  aiPercentageRPPre  Float?
  gradcamPredictionPre String?
  gradcamPercentagePre Float?
  aiReasoningPre     String?

  // Post-Op AI Results
  predictionPost     String     @default("TODO")
  aiPercentageRPPost Float?
  gradcamPredictionPost String?
  gradcamPercentagePost Float?
  aiReasoningPost    String?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  audioFiles  AudioFile[]

  @@unique([patientId])
}

model AudioFile {
  id          String   @id @default(uuid())
  patient     Patient  @relation(fields: [patientId], references: [id])
  patientId   String
  exerciseId  String
  phase       String   @default("PRE_OP") // PRE_OP, POST_OP
  storageKey  String
  createdAt   DateTime @default(now())
}
