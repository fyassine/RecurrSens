# ==============================================================================
# Environment Variables — RecurrSens
# ==============================================================================
# Copy this file to .env and fill in the values.
# Usage: cp .env.example .env
# ==============================================================================

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_SETTINGS_MODULE=config.settings.production
ALLOWED_HOSTS=recurrsens.eu,www.recurrsens.eu,212.227.176.203,localhost

# Django Superuser (created on first boot)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@recurrsens.eu
DJANGO_SUPERUSER_PASSWORD=change-me-in-production

# Database (PostgreSQL)
DB_NAME=stimmbandlaesion
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# S3 / MinIO
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_ENDPOINT=http://minio:9000
S3_BUCKET=stimmbandlaesion

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0

# Inference Service
INFERENCE_SERVICE_URL=http://inference:8001

# App URL (for QR code generation)
APP_URL=https://recurrsens.eu

# CORS (comma-separated origins allowed to make API requests)
CORS_ALLOWED_ORIGINS=https://recurrsens.eu

# CSRF trusted origins (for Django admin / session-based auth)
CSRF_TRUSTED_ORIGINS=https://recurrsens.eu,https://www.recurrsens.eu
