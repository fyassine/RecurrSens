# ==============================================================================
# Environment Variables — RecurrSens
# ==============================================================================
# Copy this file to .env and fill in the values.
# Usage: cp .env.example .env
# ==============================================================================

# Django
# NOTE: production refuses to start if any secret below is unset or left at an
# insecure default ("change-me-in-production", "minioadmin"). Generate strong,
# unique values for every deployment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_SETTINGS_MODULE=config.settings.production
# Explicit hostnames only — a wildcard ("*") is rejected in production.
ALLOWED_HOSTS=recurrsens.eu,www.recurrsens.eu,31.70.77.124,localhost

# Django Superuser (created on first boot)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@recurrsens.eu
DJANGO_SUPERUSER_PASSWORD=change-me-in-production

# Database (PostgreSQL)
DB_NAME=stimmbandlaesion
DB_USER=postgres
DB_PASSWORD=change-me-in-production
DB_HOST=db
DB_PORT=5432

# S3 / MinIO
S3_REGION=us-east-1
S3_ACCESS_KEY=change-me-in-production
S3_SECRET_KEY=change-me-in-production
S3_ENDPOINT=http://minio:9000
S3_BUCKET=stimmbandlaesion

# Celery / Redis
# REDIS_PASSWORD is required (compose fails to start without it) and is used
# both to launch redis (--requirepass) and inside CELERY_BROKER_URL.
REDIS_PASSWORD=change-me-in-production
CELERY_BROKER_URL=redis://:change-me-in-production@redis:6379/0

# Inference Service
INFERENCE_SERVICE_URL=http://inference:8001

# App URL (for QR code generation)
APP_URL=https://recurrsens.eu

# CORS (comma-separated origins allowed to make API requests)
CORS_ALLOWED_ORIGINS=https://recurrsens.eu

# CSRF trusted origins (for Django admin / session-based auth)
CSRF_TRUSTED_ORIGINS=https://recurrsens.eu,https://www.recurrsens.eu

# ==============================================================================
# Database Backup (nightly Celery task, production only)
# ==============================================================================
# Set to true ONLY on the production deployment server. When enabled, both
# GPG_RECIPIENT_KEY and GPG_PUBLIC_KEY are required — production refuses to
# boot otherwise (backups must be encrypted).
DB_BACKUP_ENABLED=false
BACKUP_ENV=production
# Number of nightly backups to keep in S3/MinIO before pruning the oldest.
BACKUP_RETENTION=30
BACKUP_S3_PREFIX=backups
# GPG key ID / email of the recipient the backup is encrypted to.
GPG_RECIPIENT_KEY=
# Base64-encoded ASCII-armored GPG public key for GPG_RECIPIENT_KEY.
# Generate with: gpg --export --armor <recipient> | base64 -w0
GPG_PUBLIC_KEY=
